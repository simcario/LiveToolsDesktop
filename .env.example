# Copia in .env (non va su git) e inserisci i valori.

# Client OAuth "Desktop app" del progetto Firebase. Letto in compilazione da src-tauri/build.rs.
LIVETOOLS_GOOGLE_CLIENT_ID=
LIVETOOLS_GOOGLE_CLIENT_SECRET=

# Configurazione del progetto Firebase (Console > Impostazioni progetto > App web). Letta da Vite in compilazione.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
